APP_NAME=golauth
MIGRATION_SOURCE_URL=./migrations
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golauth
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8080

# --- Database connection hardening (Plan 07) ---
# TLS to Postgres. Defaults to "disable" this release; the default becomes
# "require" in a following release, so set it explicitly now if you rely on it.
# Values: disable | require | verify-ca | verify-full.
# DB_SSLMODE=disable
# PEM bundle used to verify the server certificate (verify-ca / verify-full).
# DB_SSLROOTCERT=/etc/ssl/certs/db-ca.pem
# Connection pool. Idle == open avoids reconnect churn under steady load.
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# How long the boot waits for the first connection before failing (Go duration).
# DB_PING_TIMEOUT=5s
# Run schema migrations at boot. Set false to run them as a separate job.
# RUN_MIGRATIONS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Observability (Plan 12) ---
# APP_ENV also selects the log format: "production" emits JSON on stdout,
# anything else emits human-readable text on stderr.
APP_ENV=dev
# Minimum level to emit: debug | info | warn | error. Default: info.
# LOG_LEVEL=info
# JWT signing key. Leave both unset in dev to sign with an ephemeral key
# (tokens are invalidated on every restart). Set one before deploying.
# JWT_PRIVATE_KEY_FILE=./jwt-key.pem
# JWT_PRIVATE_KEY=
# JWT_PRIVATE_KEY_PREVIOUS=

# --- Login throttling (Plan 03) ---
# Per-IP sliding-window limit on POST /auth/token.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW=1m
# Comma-separated proxy IPs / CIDRs whose X-Forwarded-For is trusted for the
# client address. Leave empty when golauth is not behind a proxy.
# TRUSTED_PROXIES=
# Per-account lockout after consecutive failures: BASE_DELAY at the threshold,
# doubling each further failure, capped at MAX_DELAY.
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_BASE_DELAY=1m
# LOGIN_LOCKOUT_MAX_DELAY=15m

# --- Signup input validation (Plan 04) ---
# Reject common passwords at signup. "off" (default) disables the check;
# "on" enforces a small embedded list; any other value is a path to a
# newline-delimited file of forbidden passwords.
# PASSWORD_DENYLIST=off

# --- Server limits and shutdown (Plan 13) ---
# Bound a slow client and cap the request body (every endpoint takes small JSON).
# SERVER_READ_TIMEOUT=10s
# SERVER_WRITE_TIMEOUT=10s
# SERVER_IDLE_TIMEOUT=60s
# SERVER_BODY_LIMIT=65536
# Drain window for in-flight requests after SIGTERM before connections are cut.
# SERVER_SHUTDOWN_TIMEOUT=15s

# --- Token lifecycle (Plan 05) ---
# Access-token lifetime (Go duration). Short on purpose: it is not revocable
# before it expires. Set 60m transitionally while clients adopt the refresh flow.
# ACCESS_TOKEN_TTL=15m
# Opaque refresh-token lifetime (Go duration).
# REFRESH_TOKEN_TTL=168h
# How often expired refresh-token rows are purged (Go duration).
# REFRESH_TOKEN_CLEANUP_INTERVAL=1h
