APP_NAME=golauth
MIGRATION_SOURCE_URL=./migrations
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golauth
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=dev
# JWT signing key. Leave both unset in dev to sign with an ephemeral key
# (tokens are invalidated on every restart). Set one before deploying.
# JWT_PRIVATE_KEY_FILE=./jwt-key.pem
# JWT_PRIVATE_KEY=
# JWT_PRIVATE_KEY_PREVIOUS=

# --- Login throttling (Plan 03) ---
# Per-IP sliding-window limit on POST /auth/token.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW=1m
# Comma-separated proxy IPs / CIDRs whose X-Forwarded-For is trusted for the
# client address. Leave empty when golauth is not behind a proxy.
# TRUSTED_PROXIES=
# Per-account lockout after consecutive failures: BASE_DELAY at the threshold,
# doubling each further failure, capped at MAX_DELAY.
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_BASE_DELAY=1m
# LOGIN_LOCKOUT_MAX_DELAY=15m
